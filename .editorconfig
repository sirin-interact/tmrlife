root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[go.{mod,sum}]
indent_style = tab

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[{Caddyfile,*.caddy}]
# caddy fmt는 탭으로 들여 쓴다. 웹 이미지 빌드가 이 형식을 확인하므로 공백으로 바뀌면 빌드가 실패한다.
indent_style = tab

[*.sql]
indent_size = 4

[*.md]
# 마크다운에서 줄 끝 공백 두 칸은 줄바꿈이다.
trim_trailing_whitespace = false
