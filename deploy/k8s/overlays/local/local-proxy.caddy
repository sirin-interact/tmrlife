# 로컬 확인 전용이다. 웹 파드의 /etc/caddy/conf.d/에 끼워 넣는다.
#
# OrbStack의 쿠버네티스에는 인그레스 컨트롤러가 없다. 그래서 웹 파드 하나만 포트 포워딩으로 열어도
# 브라우저가 같은 출처로 앱 전체를 쓸 수 있도록, 운영의 인그레스가 API 서버로 보내는 경로를 웹 파드가 대신 넘겨 준다.
# 운영 이미지에는 이 파일이 들어가지 않는다.
@local_backend path /api /api/* /ws /ws/*
reverse_proxy @local_backend naeil-server:8080

# 밖에서 부른 /healthz도 운영과 같이 API 서버가 답한다.
# 호스트 이름으로 부른 요청만 넘긴다. 파드의 생존 확인은 파드 주소로 들어오므로 여기에 걸리지 않고, 웹 서버가 직접 답한다.
# 그것까지 넘기면 API 서버가 내려갔을 때 멀쩡한 웹 파드도 함께 다시 뜬다.
# 호스트 이름은 kustomization.yaml의 PUBLIC_ORIGIN과 같아야 한다.
@local_health {
	path /healthz
	host naeil.localhost
}
reverse_proxy @local_health naeil-server:8080
