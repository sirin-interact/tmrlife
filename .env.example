# 로컬 개발은 .env 없이도 돌아간다. Makefile에 개발용 기본값이 있다.
# 값을 바꾸고 싶을 때만 이 파일을 .env로 복사해 고친다. 그대로 복사해도 서버는 뜬다. .env는 git에 올리지 않는다.
# Makefile과 셸(set -a; source .env; set +a)이 같은 파일을 읽으므로
# 값은 따옴표 없이 KEY=value 꼴로 적고, 값 안에 공백, #, $를 쓰지 않는다.
# .env에 적은 값은 환경 변수보다 앞선다. 한 번만 바꿔 돌릴 때는 make의 인자로 준다 (예: make dev-server HTTP_ADDR=:18080)

# 실행 환경: dev | test | prod
APP_ENV=dev

# 서버가 듣는 주소
HTTP_ADDR=:8080

# 작업자(make dev-worker)가 상태 확인 요청을 받는 주소. 작업자만 읽는다. 8081을 다른 프로그램이 쓰고 있을 때만 바꾼다
# WORKER_HEALTH_ADDR=:8081

# 프런트 개발 서버(make dev-web)가 /api와 /ws를 넘기는 곳. HTTP_ADDR을 바꿨으면 같이 바꾼다
# API_PROXY_TARGET=http://localhost:8080

# PostgreSQL 접속 주소. 아래 값은 docker compose로 띄운 로컬 DB다
DATABASE_URL=postgres://naeil:naeil@localhost:54329/naeil?sslmode=disable

# 스키마를 한 단계 내리는 명령(server migrate down)을 허락할지. 내리면 테이블과 그 안의 데이터가 지워진다
# 적지 않으면 서버가 그 명령을 거부한다. APP_ENV=prod에서는 true여도 거부한다
# 로컬에서는 여기에 적지 말고 make migrate-down을 쓴다. 그 명령이 그때만 허락을 준다
# MIGRATE_ALLOW_DOWN=false

# 로그 수준: debug | info | warn | error
LOG_LEVEL=info

# 웹앱이 열리는 출처. 다른 출처에서 온 상태 변경 요청을 막는 데 쓴다. prod에서는 https여야 한다
PUBLIC_ORIGIN=http://localhost:5173

# 서버 앞에 있는 프록시의 주소 범위(쉼표로 나눈 CIDR). 이 범위에서 온 연결일 때만 X-Forwarded-For를 믿는다
# 비워 두면 헤더를 보지 않고 연결의 상대 주소를 클라이언트 주소로 쓴다. K3s에서는 파드 대역을 적는다 (예: 10.42.0.0/16)
TRUSTED_PROXIES=

# 세션 쿠키 이름. SESSION_COOKIE_SECURE=true면 서버가 앞에 __Host-를 붙여서 쓴다
SESSION_COOKIE_NAME=naeil_session

# 세션 쿠키를 HTTPS에서만 보낼지. dev는 false, prod는 반드시 true
SESSION_COOKIE_SECURE=false

# 로그인한 때부터 재는 세션의 전체 수명. 계속 쓰고 있어도 이 시간이 지나면 다시 로그인한다 (720h = 30일)
SESSION_ABSOLUTE_LIFETIME=720h

# 마지막으로 쓴 때부터 재는 한도. 이 시간 동안 쓰지 않으면 세션이 끝난다. 전체 수명보다 길 수 없다 (336h = 14일)
SESSION_IDLE_LIFETIME=336h

# 세션을 마지막으로 쓴 시각을 DB에 다시 적는 최소 간격. 이보다 잦은 요청은 DB에 쓰지 않는다
SESSION_TOUCH_INTERVAL=5m

# 한 주소에서 가입을 시도할 수 있는 횟수. 횟수/주기 꼴이다. 한꺼번에 그 횟수까지 되고, 쓴 만큼은 주기에 걸쳐 다시 찬다
# 한도는 프로세스마다 따로 센다. 파드를 여럿 띄우면 실제 한도는 파드 수만큼 늘어난다
# 비밀번호 해시까지 가는 시도만 센다(성공한 가입과 이미 가입된 이메일). 흔한 비밀번호나 빠진 동의로 거부된 시도는 세지 않는다
# 같은 공인 주소를 쓰는 사람들은 이 한도를 나눠 쓴다(행사장 와이파이, 통신사의 주소 변환)
# 한곳에 모여 한꺼번에 가입하는 날에는 (예상 인원 / 파드 수)에 여유를 더한 값으로 올리고, 끝나면 되돌린다
# 가입은 이메일이 이미 가입되어 있는지 알려주는 유일한 경로라서, 올려 둔 채로 두면 이메일 목록을 확인해 보기가 그만큼 쉬워진다
RATE_LIMIT_SIGNUP_PER_IP=20/1h

# 한 주소에서 로그인을 시도할 수 있는 횟수
RATE_LIMIT_LOGIN_PER_IP=30/5m

# 한 주소에서 한 계정에 로그인을 시도할 수 있는 횟수. 주소마다 따로 세므로, 남이 틀린 비밀번호를 계속 넣어도 그 사람의 주소만 막힌다
RATE_LIMIT_LOGIN_PER_EMAIL=10/10m

# 한 계정에 로그인을 시도할 수 있는 횟수를 주소를 가리지 않고 모두 센 것. 주소를 바꿔 가며 비밀번호를 대입해 보는 것을 늦춘다
# 위의 값보다 한꺼번에 받는 횟수가 많고, 다시 차는 속도도 같거나 빨라야 한다. 아니면 서버가 뜨지 않는다
# (그렇지 않으면 한 주소가 꾸준히 두드리는 것만으로 이 통을 비워 계정의 주인을 막을 수 있다)
RATE_LIMIT_LOGIN_PER_EMAIL_TOTAL=60/1h

# 한도 하나가 기억하는 주소나 계정의 최대 수. 넘치면 가장 오래 쉰 것부터 잊는다 (하나에 200바이트쯤 쓴다)
RATE_LIMIT_MAX_KEYS=50000

# 비밀번호 해시(argon2id) 하나를 계산하는 데 쓰는 메모리(KiB). 올리면 그 뒤로 로그인하는 사용자의 해시가 새 값으로 바뀐다
PASSWORD_ARGON2_MEMORY_KIB=19456

# 비밀번호 해시가 메모리를 훑는 횟수
PASSWORD_ARGON2_TIME=2

# 비밀번호 해시 계산을 나눠 맡는 갈래의 수
PASSWORD_ARGON2_PARALLELISM=1

# 동시에 계산할 수 있는 비밀번호 해시의 수. 로그인이 몰려도 메모리를 (메모리 x 이 값)까지만 쓴다
PASSWORD_HASH_CONCURRENCY=4

# 새 데이터 키를 감쌀 때 쓰는 마스터 키의 버전 번호. DATA_KEK_V<번호>가 있어야 한다
DATA_KEK_ACTIVE=1

# 마스터 키. 32바이트를 base64로 적는다. 만드는 법: openssl rand -base64 32
# 주석으로 둔 채면 make가 Makefile의 개발 전용 키를 쓴다. 그 키는 저장소에 공개된 값이라 prod에서는 서버가 거부한다
# 여기에 자리만 채운 가짜 값을 적어 두면, 이 파일을 그대로 복사했을 때 그 값이 개발 전용 키를 덮어써서 서버가 뜨지 않는다
# 키를 바꿀 때는 DATA_KEK_V2를 더하고 DATA_KEK_ACTIVE=2로 올린다. 옛 키는 지우지 않는다
# DATA_KEK_V1=

# 풀어 둔 사용자별 데이터 키를 프로세스 하나가 몇 명분까지 들고 있을지
DATA_KEY_CACHE_SIZE=1024

# 풀어 둔 데이터 키를 다시 확인하지 않고 쓰는 최대 시간. 다른 프로세스에서 지운 계정의 키를 이 시간 넘게 들고 있지 않는다
DATA_KEY_CACHE_MAX_AGE=10m

# 언어 모델의 답을 어디서 받을지: gemini | scripted
# gemini는 실제 Gemini API를 부른다. GEMINI_API_KEY가 있어야 하고, 없으면 서버가 뜨지 않는다
# scripted는 밖으로 나가지 않고 미리 정해 둔 답을 돌려준다. 키가 필요 없다. 브라우저 흐름 테스트와 키 없는 로컬 시연에 쓴다
# 비워 두면 서버가 고른다: prod에서는 gemini. 그 밖에서는 GEMINI_API_KEY가 있으면 gemini, 없으면 scripted
# 어느 쪽으로 떴는지는 서버가 시작할 때 남기는 설정 로그의 ai_provider에 나온다
# prod에서는 scripted로 뜨지 않는다. make e2e는 이 값과 상관없이 언제나 scripted로 돈다
#
# scripted로 뜬 서버도 신호 추출을 똑같이 지나가므로, 여덟 항목의 행이 정상적으로 채워진다
# 낱말 표로 가린 판단이라 실제 모델이 읽은 것과 다르다. 저장된 판단만 보고는 둘을 가릴 수 없고,
# 신호 행에 남은 추출기 표시(내부 확인 화면의 extractors)가 둘을 가르는 자리다
# 남에게 보여주기 전에 시작 로그의 ai_provider를 확인한다
AI_PROVIDER=

# 대화, 위기 판별, 일기 초안, 신호 추출에 쓰는 Gemini API 키. prod에서는 반드시 있어야 한다
# 그 밖에서는 없어도 서버가 뜬다. 그때는 정해 둔 답(scripted)으로 대화가 돌고 신호도 그 답에서 나온다
GEMINI_API_KEY=

# 음성 인식에 쓰는 Soniox API 키 (지금은 없어도 서버가 뜬다)
SONIOX_API_KEY=

# 음성 합성에 쓰는 ElevenLabs API 키 (지금은 없어도 서버가 뜬다)
ELEVENLABS_API_KEY=

# 실시간 대화에 쓰는 모델
LLM_MODEL_CONVERSATION=gemini-3.8-flash

# 대화 모델의 첫 글자가 늦을 때 예비로 부르는 모델
LLM_MODEL_CONVERSATION_FALLBACK=gemini-3.6-flash

# 위기 판별에 쓰는 모델
LLM_MODEL_GATE=gemini-3.5-flash

# 대화가 끝난 뒤의 분석(신호 추출, 일기, 기억)에 쓰는 모델
LLM_MODEL_ANALYSIS=gemini-3.8-flash

# 대화 모델의 생각하기 수준: minimal | low | medium | high
LLM_THINKING_CONVERSATION=low

# 위기 판별 모델의 생각하기 수준
LLM_THINKING_GATE=minimal

# 분석 모델의 생각하기 수준
LLM_THINKING_ANALYSIS=low

# 대화 모델의 첫 글자를 이만큼 기다린 뒤 예비 모델을 부른다 (예: 3s, 2500ms)
LLM_FALLBACK_AFTER=3s

# 대화 모델의 답을 기다리는 시간의 상한. 두 번의 시도를 합친 시간이다 (60s 이하)
# 넘기면 미리 써 둔 말이 나간다. 늦게 오는 말보다 제때 오는 안전한 말이 낫다
# LLM_FALLBACK_AFTER보다 길어야 한다. 짧으면 예비 모델을 부를 틈이 없어 이 값이 예비 모델을 조용히 꺼 버린다
LLM_REPLY_BUDGET=12s

# 위기 판별 모델의 답을 기다리는 시간. 넘기면 판별이 실패한 것으로 보고 규칙의 판정만으로 대응한다 (30s 이하)
# 사용자는 이 시간이 지나야 답을 받는다. 늘리면 느린 날의 대화가 그만큼 굼떠진다
GATE_AI_TIMEOUT=2500ms

# 신호 추출 모델의 출력 한도(토큰). 1024에서 65536 사이
# 한 번의 답에 여덟 항목의 판단과 항목마다의 근거 발화가 모두 담기고, 겉으로 보이지 않는 생각 토큰도 여기서 빠진다
# 빠듯하면 답이 항목 중간에서 잘리고, 잘린 답은 여덟 항목을 채우지 못해 버려진다
LLM_MAX_OUTPUT_ANALYSIS=8192

# 신호 추출 모델의 답을 기다리는 시간 (5m 이하)
# 대화가 끝난 뒤에 도는 일이라 느린 답도 기다릴 수 있지만, 아주 느린 응답 하나에 작업자 한 자리가 오래 묶이지 않게 끝을 둔다
LLM_ANALYSIS_BUDGET=60s

# 이 시간 동안 말이 없으면 한 번 묻는다
IDLE_CHECK_AFTER=3m

# 묻고 나서 이 시간 동안 답이 없으면 대화를 끝낸다. 일기 초안은 그대로 만들어진다
IDLE_END_AFTER=3m

# 연결이 끊긴 대화를 열어 둔 채 기다리는 시간. 그 안에 돌아오면 같은 대화를 이어가고, 아니면 끝낸다
DISCONNECT_END_AFTER=30m

# 대화 채널(WebSocket)이 클라이언트에서 받는 메시지 하나의 최대 크기(바이트). 1024에서 1048576 사이
WS_MAX_MESSAGE_BYTES=16384

# 대화 채널의 연결 하나가 보낼 수 있는 메시지의 빈도. 횟수/주기 꼴이다
# 글 하나마다 모델을 두세 번 부르므로 비용의 상한이기도 하다
WS_MESSAGE_RATE_LIMIT=20/1m

# 일기 초안을 만들지 못했을 때 다시 시도하는 횟수(처음 한 번은 세지 않는다). 0에서 10 사이
# 다 쓰고도 만들지 못하면 빈 초안을 남겨 사용자가 직접 쓸 수 있게 한다
DIARY_JOB_RETRIES=3

# 마음 신호를 뽑지 못했을 때 다시 시도하는 횟수(처음 한 번은 세지 않는다). 0에서 10 사이
# 다 쓰고도 뽑지 못하면 그 대화의 분석을 실패로 닫고 신호를 하나도 남기지 않는다
# 일부 항목만 남기는 길은 없다. 그날은 분석이 끝날 때까지 대화하지 않은 날과 똑같이 다뤄진다
ANALYSIS_JOB_RETRIES=3
