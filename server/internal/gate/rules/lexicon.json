{
  "fragments": {
    "WANT": "[고구](?:만|는|도)?(?:싶|십|시[퍼프픔]|파|프|픈|팠|픔)",
    "SUBJ": "(?:이가|이|가|은|는|도|께서|들이|들은|들도)",
    "OTHER": "(?:친구|동생|언니|오빠|누나|형|엄마|아빠|어머니|아버지|어머님|아버님|할머니|할아버지|이모|고모|삼촌|사촌|선배|후배|동기|동료|팀장님?|부장님?|과장님?|대리님?|사장님?|대표님?|교수님?|선생님?|쌤|애인|남친|여친|남자친구|여자친구|남편|아내|와이프|아들|딸|조카|지인|이웃|걔|쟤|얘|그애|그사람|그분|그친구|누가|누군가|사람들|남들|환자|연예인|가수|배우|아이돌|유튜버|주인공|강아지|고양이|반려견|반려묘|햄스터|물고기|금붕어|화분|식물|벌레|모기|바퀴벌레)",
    "PAST": "(?:예전|옛날|이전에|한때|어릴때|어렸을때|학생때|학창시절|고등학교때|고딩때|중학교때|중딩때|대학교때|대학때|군대에서|작년|재작년|몇년전|년전|몇달전|달전|그때는?|그당시|과거)",
    "WORK": "(?:과제|숙제|보고서|레포트|리포트|업무|작업|공부|프로젝트|발표|원고|논문|코딩|게임|드라마|시험|마감|이거|그거|이것|그것|청소|빨래|운동|다이어트|연애|관계|알바|회의|수업|강의|학원|회사|직장|동아리|과외|준비|연습|정리)",
    "DEATHWORD": "(?:죽|자살|자해|극단적|목숨|투신|유서)"
  },
  "first_person": "나도|나는|내가|나까지|나역시|나또한|나한테|나만|저도|저는|제가",
  "me_too": "나도|저도|나역시|나또한|나까지|따라",
  "entries": [
    {
      "id": "s3.method.pills_hoard",
      "stage": 3,
      "pattern": "(?:약|수면제|알약|졸피뎀|진통제|타이레놀)(?:을|를|도|은|는|만)?(?:조금씩|몰래|계속|잔뜩|많이|한움큼)?(?:모아|모으|모은|쟁여)",
      "unless": ["g.other.actor"],
      "note": "약을 모아 두는 준비 행동. 약을 모아뒀어, 수면제 모으는 중"
    },
    {
      "id": "s3.method.overdose",
      "stage": 3,
      "pattern": "(?:약|수면제|알약|졸피뎀)(?:을|를)?(?:한꺼번에|한번에|다|몽땅|전부|통째로|한통|한움큼)(?:다)?(?:먹으려|먹을까|먹을거|먹을꺼|먹어버릴|먹어버리<WANT>|먹<WANT>|삼키려|삼킬까|털어넣)|(?:약|수면제|알약|졸피뎀)(?:을|를)?(?:한꺼번에|한번에|몽땅|통째로|한통을?|수십알|여러알|한움큼)(?:다)?(?:먹었|삼켰|먹어버렸)|(?:약|수면제)(?:을|를)?(?:털어넣|먹고죽|먹고끝)",
      "unless": ["g.other.actor"],
      "note": "약을 한꺼번에 먹으려는 의도나 먹은 일. 먹던 약을 다 먹었다는 말은 걸리지 않게 의도 어미를 붙였다"
    },
    {
      "id": "s3.method.charcoal",
      "stage": 3,
      "pattern": "(?:번개탄|착화탄|연탄)(?:을|를|도|은)?.{0,10}?(?:샀|사놨|사뒀|사왔|사다|사러|주문|준비|검색|찾아봤|알아봤|알아보|피우|피워|피울|어디서파|구했|구해)",
      "unless": ["x.context.camping", "g.other.actor"],
      "note": "번개탄을 사거나 알아보는 준비 행동. 캠핑과 고기 굽는 이야기는 뺀다"
    },
    {
      "id": "s3.method.hanging",
      "stage": 3,
      "pattern": "목(?:을|이라도)?(?:매달|매고|매서|매려|매야|맬|맸|매는)|목매(?:달|고|서|려)",
      "unless": ["g.other.actor"],
      "note": "목을 매는 방법"
    },
    {
      "id": "s3.method.jump",
      "stage": 3,
      "pattern": "뛰어내리(?:<WANT>|려|면|자|기로|는게|는상상|는생각)|뛰어내릴(?:까|래|거|꺼|생각|것|듯|뻔|려)|뛰어내려(?:야|버릴|버리<WANT>|볼까)|투신(?:하<WANT>|할|하려|하면|해야)|몸을?던지<WANT>|몸을?던질|(?:한강|강물|강에|바다|차도|도로|선로|지하철|기차|차에|트럭)(?:에|로|으로)?(?:확|그냥)?뛰어들|(?:옥상|난간|다리위|대교|베란다|창밖|창문밖)(?:에|에서|으로|위에)?.{0,8}?(?:떨어지<WANT>|떨어질까|떨어지면|떨어져버릴|서있었|서있어|서봤|올라섰|올라서)",
      "unless": ["g.other.actor", "x.context.fiction", "x.context.news"],
      "note": "뛰어내리거나 뛰어드는 방법. 바람이나 의도의 어미가 붙었을 때만 건다"
    },
    {
      "id": "s3.method.search",
      "stage": 3,
      "pattern": "(?:자살|죽는|죽을|(?:안아프게|편하게|고통없이|쉽게|조용히|편히)죽(?:는|을))(?:하는)?(?:방법|법|수단)|자살(?:사이트|카페|모집)|동반자살|치사량",
      "unless": ["x.context.fiction", "x.context.news"],
      "note": "방법을 찾아보는 행동"
    },
    {
      "id": "s3.method.blade",
      "stage": 3,
      "pattern": "(?:커터칼|면도날|면도칼)(?:을|를|도)?.{0,8}?(?:샀|준비|꺼내|들고|쥐고|옆에|대고|챙겼)",
      "unless": ["g.other.actor"],
      "note": "날붙이를 준비하거나 손에 든 상태"
    },
    {
      "id": "s3.method.poison",
      "stage": 3,
      "pattern": "(?:농약|제초제|청산가리|독극물|독약)(?:을|를|도)?.{0,8}?(?:샀|구했|구해|주문|마시|마실|먹으|먹을)",
      "unless": ["g.other.actor", "x.context.news"],
      "note": "독성 물질을 구하거나 먹으려는 말"
    },
    {
      "id": "s3.plan.intent",
      "stage": 3,
      "pattern": "죽으려고?|죽을려고?|죽으려구|죽을라고|죽으러|죽기로|죽을(?:준비|계획|장소|곳|방법)|자살(?:계획|하려|할거|할꺼|할게|할래|하기로|시도하려|시도할|준비|할생각|할작정)|(?:날짜|날|시간|장소|방법)(?:를|을|도|는|까지)?(?:다)?(?:정했|정해놨|정해뒀|잡았|골랐|골라놨).{0,10}?(?:죽|자살|끝내|떠나)|(?:죽|자살|끝낼|떠날).{0,10}?(?:날짜|날|시간|장소|방법)(?:를|을|도|는|까지)?(?:다)?(?:정했|정해놨|정해뒀|잡았|골랐|찾았|찾아놨)",
      "unless": ["g.past", "g.other.actor", "g.other.die", "x.idiom.scold", "x.context.fiction", "x.context.news"],
      "note": "죽으려는 의도와 계획. 지난 일로 말한 것은 1단계 항목이 받는다"
    },
    {
      "id": "s3.plan.timed",
      "stage": 3,
      "pattern": "(?:오늘|오늘밤에?|오늘저녁에?|밤에|이따가?|내일|모레|이번주말에?|이번주에?|주말에|조만간|곧|생일에|생일날)(?:은|는|이|안에)?(?:꼭|진짜|그냥|다|전부|모두)?(?:끝내려|끝낼거|끝낼꺼|끝낼게|끝낼래|끝내기로|끝내버리|끝장내|죽을거|죽을꺼|죽을게|죽을래|죽어야|죽자)",
      "unless": ["g.work_object", "x.idiom.as_if", "x.idiom.in_trouble"],
      "note": "시점이 붙은 끝내겠다는 말. 오늘 밤에 끝내려고. 같은 발화 안에 끝낼 일감이 적혀 있으면 뺀다"
    },
    {
      "id": "s3.prep.will",
      "stage": 3,
      "pattern": "유서|유언장|유언(?:을|도|은|이라도)?(?:쓰|썼|써|남기|남겼|남길)",
      "unless": ["x.homonym.heritage", "x.context.fiction", "x.context.news", "x.context.lyrics", "g.other.actor"],
      "note": "유서를 쓰는 준비 행동. 쓰다가 지웠다는 말도 건다"
    },
    {
      "id": "s3.prep.affairs",
      "stage": 3,
      "pattern": "신변정리|주변정리|영정사진",
      "unless": ["g.other.actor", "x.context.fiction", "x.context.news"],
      "note": "떠날 준비로 주변을 정리하는 행동"
    },
    {
      "id": "s3.farewell.thanks",
      "stage": 3,
      "pattern": "그동안(?:정말|진짜|너무|참|다들|모두)?(?:고마웠|감사했|미안했|즐거웠|행복했|수고많|신세많)",
      "unless": ["g.farewell_context"],
      "note": "작별 인사. 그동안 고마웠어. 퇴사, 졸업처럼 헤어지는 일을 말하는 자리와 남에게 한 말을 옮긴 것은 뺀다"
    },
    {
      "id": "s3.farewell.last",
      "stage": 3,
      "pattern": "마지막일기|(?:이게|이번이|오늘이|이것이)(?:내|제|나의)?마지막(?:대화|인사|편지|메시지|기록|글)",
      "note": "마지막이라는 작별. 이게 마지막 일기일 거야"
    },
    {
      "id": "s3.farewell.bye",
      "stage": 3,
      "pattern": "(?:내|나)(?:가)?없어도(?:다들|모두|너는|넌)?잘(?:살|지내|있)|먼저가서미안|먼저가는(?:걸|거|것을?)용서|다음생에(?:는|선)?(?:만나|보자|봐)|(?:엄마|아빠|부모님|가족들?|얘들아|다들|모두)(?:한테)?(?:미안해|미안하다|죄송해요|사랑해|고마워).{0,6}?(?:먼저|이제)(?:갈게|간다|가요|떠나)",
      "note": "남는 사람에게 건네는 작별의 말"
    },
    {
      "id": "s2.wish.always",
      "stage": 2,
      "pattern": "죽<WANT>지않은(?:날|적|순간)(?:이|은)?(?:없|하루도)",
      "note": "부정이 두 번 겹친 말. 죽고 싶지 않은 날이 없어. 부정 가드에 가려지지 않게 따로 둔다"
    },
    {
      "id": "s2.wish.die",
      "stage": 2,
      "pattern": "죽<WANT>|죽어버리<WANT>|죽어버렸으면|죽었으면(?:좋|싶|해|하|$)|죽어버릴까|죽을까|죽을래|죽어야(?:지|겠|하나|되나|할까|될까|할것|될것|끝나|편해)|죽는게(?:낫|나을|나아|편|답)|죽는편이|죽으면(?:편|끝|다끝|좋겠|되나|될까|어떨까|괜찮|그만|해결|다해결)|죽어버려야|죽어도(?:상관없|괜찮|그만)|콱죽|확죽어|죽음(?:을|이)?(?:원해|원한|바라|바란|택하|선택)",
      "unless": ["g.negated", "g.past", "g.fear", "g.other.quote", "g.other.die", "g.quoted_in_work", "x.idiom.embarrassed", "x.idiom.scold", "x.idiom.old", "x.idiom.as_if"],
      "note": "지금 죽고 싶다는 직접 표현. 어간 죽에 바람과 의도의 어미를 붙였다"
    },
    {
      "id": "s2.wish.die_slang",
      "stage": 2,
      "pattern": "(?:뒤지|디지|뒈지|뒤져버리)<WANT>|뒤질래|뒤질까|디질래|뒈질래",
      "unless": ["g.negated", "g.past"],
      "note": "죽다의 속된 말에 바람의 어미가 붙은 것"
    },
    {
      "id": "s2.wish.suicide",
      "stage": 2,
      "pattern": "자살(?:을)?(?:하|해버리)?<WANT>|자살할까|자살해야|자살하면|자살(?:을)?생각|자살충동|자살하는게|자살밖에|자살뿐|자살(?:이|만이)답|극단적(?:인)?(?:선택|생각)(?:을|이|도)?(?:하<WANT>|할까|해야|하게|들어|든다|들었|드는|떠올|고민)",
      "unless": ["g.negated", "g.past", "g.other.quote", "g.other.actor", "g.quoted_in_work", "x.context.fiction", "x.context.news"],
      "note": "자살이라는 낱말로 말한 지금의 생각"
    },
    {
      "id": "s2.wish.killme",
      "stage": 2,
      "pattern": "(?:나|날|나좀|날좀|나를|저를|절)(?:좀|그냥)?죽여(?:줘|줬으면|주면|주라|달라|주세요)|누가(?:나|날|나를)?(?:좀|그냥)?죽여줬으면|차에치(?:였으면|이면좋|여죽)|사고(?:로|라도|가)?(?:나서|나면)?(?:그냥)?죽었으면|(?:병|암)(?:에|이라도)걸려(?:서)?죽었으면",
      "note": "누가 끝내 주었으면 하는 수동적인 죽음의 바람"
    },
    {
      "id": "s2.not_live",
      "stage": 2,
      "pattern": "살기(?:가|도)?싫|살고싶지(?:가|도|는)?않|살고싶은(?:마음|생각)(?:이|도)?(?:없|안)|살아서뭐|살아뭐해|살아뭐하|살아봤자|왜사는지모르|왜살아야|왜사나싶|왜사는걸까|살(?:아야할|아갈|아야될|아야하는)?이유(?:를|가|도)?(?:모르|없|못찾|찾지못)|사는이유(?:를|가|도)?(?:모르|없)|그만살<WANT>|더(?:는|이상)?살<WANT>지않|더(?:는|이상)살기싫|살아갈(?:자신|힘|용기|의욕)(?:이|도)?없|살(?:가치|자격)(?:가|이|도)?없|살의욕(?:이|도)?없|삶의?(?:이유|의미)(?:를|가|도)?(?:모르|없|잃)|삶을(?:끝내|포기|놓|마감|그만)|생을(?:마감|끝내|포기|놓)|인생(?:을)?(?:끝내<WANT>|끝내버리|마감|그만두<WANT>|포기하<WANT>)|목숨(?:을)?(?:끊|버리|놓)|스스로(?:목숨|생을)|세상(?:을|에서)?(?:떠나<WANT>|뜨<WANT>|등지|하직|없어지<WANT>|사라지<WANT>)",
      "unless": ["g.live_place", "g.live_like_this", "g.other.quote", "g.other.life", "x.context.fiction", "x.context.news"],
      "note": "살 이유가 없다, 살기 싫다는 직접 표현. 사는 곳이나 같이 사는 사람에 대한 말은 뺀다"
    },
    {
      "id": "s2.selfharm.act",
      "stage": 2,
      "pattern": "또자해|자해(?:를|도|만)?(?:했|해버렸|하고있|하는중|하게돼|하게되|하고말았|해왔|하곤해|한지|할까|할것같|충동|욕구)|자해(?:를)?(?:하)?<WANT>|손목(?:을|도|에)?(?:그었|그어|긋고|긋는|그을|베었|벴|칼)|(?:팔|허벅지|다리|손등|팔뚝)(?:을|도|에|를)?(?:그었|그어|긋고|긋는|그을|칼로|칼을)|(?:칼|커터칼|면도날|가위|유리조각|컴퍼스)(?:로|으로)(?:내|제)?(?:팔|손목|허벅지|다리|몸|살)(?:을|를|에)?(?:그었|그어|긋|베었|벴|찔렀|찌르)|(?:내|제)(?:몸|팔|손목|살)(?:에|을|를)(?:상처|칼|담배)|(?:나를|날|내몸을|스스로를?|내자신을|제자신을)(?:때렸|때리고|때리게|할퀴|꼬집|해치|다치게|물어뜯)|머리를?(?:벽에)?(?:박았|찧었|쥐어뜯)",
      "unless": ["g.past", "g.other.actor", "x.context.fiction", "x.context.news"],
      "note": "자해 행동과 충동. 자해는 이제 안 해 같은 말은 여기 걸리지 않고 포괄 패턴이 받는다"
